meta {
  name: 14.09 Cancel Specific Background Job
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/admin/ai/jobs/{{adminCancelJobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

vars:pre-request {
  adminCancelJobId: dummy-job-id-for-testing
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('adminToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'admin@quicktest.com',
        password: 'Admin@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('adminToken', token);
        bru.setEnvVar('adminToken', token);
      }
    } catch (e) {}
  }
}
