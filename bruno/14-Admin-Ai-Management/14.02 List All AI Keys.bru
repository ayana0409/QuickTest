meta {
  name: 14.02 List All AI Keys
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/ai/keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data: isDefined
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('adminToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'admin@quicktest.com',
        password: 'Admin@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('adminToken', token);
        bru.setEnvVar('adminToken', token);
      }
    } catch (e) {}
  }
}

script:post-response {
  if (res.body?.data && res.body.data.length > 0) {
    const firstKey = res.body.data[0];
    bru.setVar('adminAiKeyId', firstKey.id);
    bru.setEnvVar('adminAiKeyId', firstKey.id);
    if (firstKey.models && firstKey.models.length > 0) {
      bru.setVar('adminAiModelId', firstKey.models[0].id);
      bru.setEnvVar('adminAiModelId', firstKey.models[0].id);
    }
  }
}
