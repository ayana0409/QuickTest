meta {
  name: 14.05 Update AI Key
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/admin/ai/keys/{{createdAiKeyId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Updated Gemini Key (Testing)",
    "apiKey": "AIzaSyDummyKeyForTestingOnlyUpdated9999",
    "provider": "GEMINI",
    "isActive": true,
    "orderIndex": 5,
    "models": [
      {
        "modelName": "gemini-1.5-flash",
        "rpm": 20,
        "tpm": 1500000,
        "isActive": true,
        "orderIndex": 0
      }
    ]
  }
}

vars:pre-request {
  createdAiKeyId: {{createdAiKeyId}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.name: eq "Updated Gemini Key (Testing)"
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('adminToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'admin@quicktest.com',
        password: 'Admin@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('adminToken', token);
        bru.setEnvVar('adminToken', token);
      }
    } catch (e) {}
  }
}
