meta {
  name: 12.02 Get Quiz Generation Job Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/teacher/ai-generate/jobs/{{aiQuizJobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

vars:pre-request {
  aiQuizJobId: {{aiQuizJobId}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.jobId: isDefined
  res.body.data.status: in ["QUEUED", "PROCESSING", "COMPLETED", "FAILED"]
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('teacherToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('teacherToken', token);
        bru.setEnvVar('teacherToken', token);
      }
    } catch (e) {}
  }
}
