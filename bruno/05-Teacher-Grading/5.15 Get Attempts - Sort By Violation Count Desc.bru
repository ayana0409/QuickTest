meta {
  name: 5.15 Get Attempts - Sort By Violation Count Desc
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/teacher/grading/exams/{{examId}}/attempts?page=0&size=10&sort=violationCount,desc
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 10
  sort: violationCount,desc
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.content: isDefined
}
