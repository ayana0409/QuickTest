meta {
  name: 5.12 Get Attempts - Filter By Status and Search
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/teacher/grading/exams/{{examId}}/attempts?status=SUBMITTED&search=student&page=0&size=10
  body: none
  auth: bearer
}

params:query {
  status: SUBMITTED
  search: student
  page: 0
  size: 10
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.content: isDefined
}
