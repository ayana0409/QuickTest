meta {
  name: 4.13 Get Submission Result - Polling
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/session/{{attemptId}}/result
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{studentToken}}
}

vars:pre-request {
  attemptId: a18c6c49-25fd-44f9-878f-320d2f747c35
}

assert {
  res.status: eq 200
}
