meta {
  name: 4.02 Start Exam - Anonymous Guest
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/session/start
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "accessCode": "{{accessCode}}",
    "guestName": "Khách Vãng Lai",
    "guestIdentifier": "{{guestIdentifier}}"
  }
}

assert {
  res.status: eq 200
}
