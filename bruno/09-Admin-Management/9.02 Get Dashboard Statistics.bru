meta {
  name: 9.02 Get Dashboard Statistics
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/dashboard
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

vars:pre-request {
  adminToken: eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiIsInVzZXJJZCI6ImI1OWI0OTQzLTIwODEtNDFiOS05MjJiLWRmNThlZWY1NjdiOSIsImVtYWlsIjoiYWRtaW5AcXVpY2t0ZXN0LmNvbSIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc4OTIxNzYwMCwiZXhwIjoxNzg5MzA0MDAwfQ.Qkb6BUcSPU6ZpInlUP6HSm7UI6mpzjNZG755u2Q-_a4
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.totalUsers: gte 1
}
