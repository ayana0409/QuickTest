meta {
  name: 9.05d Admin Reset User Password - Success
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/api/admin/users/{{newAdminUserId}}/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "NewAdminProvisionedPass@123"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.message: eq Password reset successfully
}
