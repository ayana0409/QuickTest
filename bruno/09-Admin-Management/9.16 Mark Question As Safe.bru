meta {
  name: 9.16 Mark Question As Safe
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/admin/moderation/questions/{{moderationQuestionId}}/safety
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isSafe": true
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.isSafe: eq true
  res.body.data.reviewedByName: isDefined
}
