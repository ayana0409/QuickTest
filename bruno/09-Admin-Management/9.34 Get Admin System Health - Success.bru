meta {
  name: 9.34 Get Admin System Health - Success
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/api/admin/system/health
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.database: isDefined
  res.body.redis: isDefined
}
