meta {
  name: 9.14 List Moderation Questions - Filter Has Image & Unsafe
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/admin/moderation/questions?isSafe=false&hasImage=true&page=0&size=10
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.content: isDefined
}
