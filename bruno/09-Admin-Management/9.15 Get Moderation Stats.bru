meta {
  name: 9.15 Get Moderation Stats
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/admin/moderation/stats
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.totalQuestions: gte 0
  res.body.data.questionsWithImages: gte 0
  res.body.data.unreviewedQuestions: gte 0
  res.body.data.safeQuestions: gte 0
}
