meta {
  name: 9.07 Toggle User Status - Reactivate
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/admin/users/{{targetUserId}}/toggle-status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.id: eq {{targetUserId}}
  res.body.data.isActive: eq true
}
