meta {
  name: 9.08 Update User Role - Promote to Teacher
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/admin/users/{{targetUserId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "role": "TEACHER"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.role: eq TEACHER
}
