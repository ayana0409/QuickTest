meta {
  name: 9.01 Admin Login - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "usernameOrEmail": "admin@quicktest.com",
    "password": "Admin@123"
  }
}

assert {
  res.status: eq 200
  res.body.data.userInfo.roles: isDefined
}

script:post-response {
  let token = res.body?.data?.accessToken || res.body?.data?.token;
  if (token) {
    bru.setVar("adminToken", token);
    bru.setEnvVar("adminToken", token);
  }
  let id = res.body?.data?.userInfo?.id;
  if (id) {
    bru.setVar("adminUserId", id);
    bru.setEnvVar("adminUserId", id);
  }
}

