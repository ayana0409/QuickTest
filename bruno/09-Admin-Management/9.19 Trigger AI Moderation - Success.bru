meta {
  name: 9.19 Trigger AI Moderation - Success
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/admin/moderation/ai-run
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: in [200, 202]
  res.body.status: eq 200
  res.body.data.running: isDefined
  res.body.data.message: isDefined
}
