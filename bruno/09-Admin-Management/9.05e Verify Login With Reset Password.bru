meta {
  name: 9.05e Verify Login With Reset Password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "usernameOrEmail": "{{updatedTeacherUsername}}",
    "password": "NewAdminProvisionedPass@123"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.accessToken: isDefined
}
