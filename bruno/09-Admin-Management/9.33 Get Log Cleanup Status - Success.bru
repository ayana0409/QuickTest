meta {
  name: 9.33 Get Log Cleanup Status - Success
  type: http
  seq: 43
}

get {
  url: {{baseUrl}}/api/admin/logs/cleanup/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data: isDefined
}
