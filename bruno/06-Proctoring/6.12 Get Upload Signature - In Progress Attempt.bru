meta {
  name: 6.12 Get Upload Signature - In Progress Attempt
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/session/{{liveAttemptId}}/proctoring/upload-signature
  body: none
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  const studentToken = bru.getEnvVar('studentToken') || bru.getVar('studentToken');
  const accessCode = bru.getEnvVar('accessCode') || bru.getVar('accessCode');

  // Attempt to start a fresh session or reuse existing attemptId
  let targetId = bru.getEnvVar('attemptId') || bru.getVar('attemptId');
  if (accessCode && studentToken) {
    try {
      const res = await axios.post(`${baseUrl}/api/session/start`, {
        accessCode: accessCode
      }, {
        headers: { Authorization: `Bearer ${studentToken}` }
      });
      if (res.data?.data?.attemptId) {
        targetId = res.data.data.attemptId;
      }
    } catch (e) {}
  }
  bru.setVar('liveAttemptId', targetId || '00000000-0000-0000-0000-000000000000');
}

assert {
  // Returns 200 if IN_PROGRESS, or 400 if attempt was already completed/disqualified
  res.status: in [200, 400]
}
