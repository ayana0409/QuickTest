meta {
  name: 6.05 Get Attempt Status - Success
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/teacher/proctoring/attempts/{{attemptId}}/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.attemptId: isDefined
  res.body.data.status: isDefined
}
