meta {
  name: 6.11 Candidate Report Violation - Not Found
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/session/proctoring/violations
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "attemptId": "00000000-0000-0000-0000-000000000000",
    "violationType": "TAB_SWITCH",
    "description": "Tab switch reported for non-existent attempt"
  }
}

assert {
  res.status: eq 404
}
