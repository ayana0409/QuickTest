meta {
  name: 7.01 Upload Single Question Image - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/teacher/media/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

body:multipart-form {
  folderType: questions
  file: @file(fixtures/sample.png)
}

assert {
  res.status: in [200, 503]
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('teacherToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('teacherToken', token);
        bru.setEnvVar('teacherToken', token);
      }
    } catch (e) {}
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    if (res.body.data.url) {
      bru.setVar("uploadedImageUrl", res.body.data.url);
      bru.setEnvVar("uploadedImageUrl", res.body.data.url);
    }
    if (res.body.data.publicId) {
      bru.setVar("uploadedImagePublicId", res.body.data.publicId);
      bru.setEnvVar("uploadedImagePublicId", res.body.data.publicId);
    }
  }
}
