meta {
  name: 7.02 Upload Single - Forbidden Student
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/teacher/media/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:multipart-form {
  folderType: questions
  file: @file(fixtures/sample.png)
}

assert {
  res.status: eq 403
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('studentToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'student@quicktest.com',
        password: 'Student@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('studentToken', token);
        bru.setEnvVar('studentToken', token);
      }
    } catch (e) {}
  }
}
