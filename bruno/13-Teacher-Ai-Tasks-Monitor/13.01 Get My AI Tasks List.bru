meta {
  name: 13.01 Get My AI Tasks List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/teacher/ai-tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data: isDefined
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('teacherToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('teacherToken', token);
        bru.setEnvVar('teacherToken', token);
      }
    } catch (e) {}
  }
}

script:post-response {
  if (res.body?.data && res.body.data.length > 0) {
    const firstTask = res.body.data[0];
    bru.setVar('aiTaskId', firstTask.taskId);
    bru.setEnvVar('aiTaskId', firstTask.taskId);
  }
}
