meta {
  name: 8.01 Get Questions For Grading
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/teacher/grading/exams/{{examId}}/questions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data: isDefined
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('teacherToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('teacherToken', token);
        bru.setEnvVar('teacherToken', token);
      }
    } catch (e) {}
  }
  const token = bru.getEnvVar('teacherToken');
  if (!bru.getEnvVar('examId') || bru.getEnvVar('examId').startsWith('{{')) {
    try {
      const examRes = await axios.post(`${baseUrl}/api/teacher/exams`, {
        title: 'Question Centric Grading Exam',
        accessCode: 'GRADE' + Math.floor(1000 + Math.random() * 9000),
        description: 'Auto exam for question-centric grading',
        durationMinutes: 60,
        maxAttempts: 2
      }, {
        headers: { Authorization: `Bearer ${token}` }
      });
      const eid = examRes.data?.data?.id;
      if (eid) {
        bru.setVar('examId', eid);
        bru.setEnvVar('examId', eid);

        // Add an essay question to this exam
        const qRes = await axios.post(`${baseUrl}/api/teacher/exams/${eid}/questions`, {
          orderIndex: 1,
          content: 'Trình bày quá trình quang hợp ở thực vật và vai trò đối với sinh quyển.',
          questionType: 'ESSAY_TEXT',
          points: 3.0,
          sampleAnswer: 'Quang hợp gồm pha sáng và pha tối. Giúp tạo oxy và chất hữu cơ duy trì sự sống.',
          gradingRubric: 'Nêu đủ 2 pha (1.5đ), nêu vai trò tạo O2 và hấp thụ CO2 (1.5đ).'
        }, {
          headers: { Authorization: `Bearer ${token}` }
        });
        const qid = qRes.data?.data?.id;
        if (qid) {
          bru.setVar('essayQuestionId', qid);
          bru.setEnvVar('essayQuestionId', qid);
        }
      }
    } catch (e) {}
  }
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    const q = res.body.data[0];
    bru.setVar('essayQuestionId', q.questionId);
    bru.setEnvVar('essayQuestionId', q.questionId);
  }
}
