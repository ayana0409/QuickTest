meta {
  name: 8.02 Get Question Submissions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/teacher/grading/questions/{{essayQuestionId}}/submissions?status=PENDING_MANUAL&page=0&size=10
  body: none
  auth: bearer
}

params:query {
  status: PENDING_MANUAL
  page: 0
  size: 10
}

auth:bearer {
  token: {{teacherToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.sampleAnswer: isDefined
  res.body.data.gradingRubric: isDefined
  res.body.data.submissions: isDefined
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('teacherToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const token = res.data?.data?.accessToken || res.data?.data?.token;
      if (token) {
        bru.setVar('teacherToken', token);
        bru.setEnvVar('teacherToken', token);
      }
    } catch (e) {}
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.submissions && res.body.data.submissions.content) {
    const list = res.body.data.submissions.content;
    if (list.length > 0) {
      bru.setVar('candidateAnswerId', list[0].candidateAnswerId);
      bru.setEnvVar('candidateAnswerId', list[0].candidateAnswerId);
    }
  }
}
