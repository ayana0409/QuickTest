meta {
  name: 2.19 Publish Republishable Exam
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/teacher/exams/{{republishExamId}}/publish
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.status: eq PUBLISHED
}
