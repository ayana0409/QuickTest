meta {
  name: 2.20 Close Republishable Exam
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/teacher/exams/{{republishExamId}}/close
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.status: eq CLOSED
}
