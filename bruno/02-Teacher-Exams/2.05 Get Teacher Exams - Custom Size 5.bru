meta {
  name: 2.05 Get Teacher Exams - Custom Size 5
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/teacher/exams?page=0&size=5
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 5
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}
