meta {
  name: 2.25 Close Republishable Exam Again
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/teacher/exams/{{republishExamId}}/close
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.status: eq CLOSED
}
