meta {
  name: 3.09 Add Question To Delete
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/teacher/exams/{{examId}}/questions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "orderIndex": 99,
    "content": "Câu hỏi tạm thời dùng để kiểm tra tính năng xóa câu hỏi",
    "questionType": "NUMERIC",
    "points": 1.0,
    "sampleAnswer": "100"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setVar("tempQuestionId", res.body.data.id);
    bru.setEnvVar("tempQuestionId", res.body.data.id);
  }
}
