meta {
  name: 3.14 Get Question Bank - Search And Filter
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/teacher/question-bank?search=Pháp&page=0&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.content: isDefined
}
