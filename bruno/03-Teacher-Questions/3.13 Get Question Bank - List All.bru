meta {
  name: 3.13 Get Question Bank - List All
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/teacher/question-bank?page=0&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.data.content: isDefined
}
