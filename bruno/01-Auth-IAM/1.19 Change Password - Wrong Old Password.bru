meta {
  name: 1.19 Change Password - Wrong Old Password
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "oldPassword": "WrongCurrentPassword@123",
    "newPassword": "NewTeacherPassword@123",
    "confirmPassword": "NewTeacherPassword@123"
  }
}

assert {
  res.status: eq 400
}
