meta {
  name: 1.14 SSO QuickBite - Missing Token Error
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/auth/sso/quickbite
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "accessToken": ""
  }
}

assert {
  res.status: eq 400
}
