meta {
  name: 1.07 Login - Bad Credentials
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "usernameOrEmail": "teacher@quicktest.com",
    "password": "WrongPassword@999"
  }
}

assert {
  res.status: eq 401
}
