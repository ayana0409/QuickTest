meta {
  name: 1.02 Register Student - Success
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

script:pre-request {
  // Use timestamp to guarantee unique credentials on repeatable collection runs
  const rand = Date.now();
  bru.setVar("regStudentUser", "student_" + rand);
  bru.setVar("regStudentEmail", "student_" + rand + "@quicktest.com");
}

body:json {
  {
    "username": "{{regStudentUser}}",
    "email": "{{regStudentEmail}}",
    "password": "Student@123",
    "fullName": "Bruno Dynamic Student",
    "role": "STUDENT"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  let token = res.body?.data?.accessToken || res.body?.data?.token;
  if (token) {
    bru.setVar("studentToken", token);
    bru.setEnvVar("studentToken", token);
  }
}
