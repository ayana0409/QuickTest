meta {
  name: 1.20 Change Password - Success Disposable User
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{disposableUserToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  const rand = Date.now();
  const username = "pwd_user_" + rand;
  const email = "pwd_user_" + rand + "@quicktest.com";

  try {
    const regRes = await axios.post(`${baseUrl}/api/auth/register`, {
      username: username,
      email: email,
      password: "InitialPassword@123",
      fullName: "Password Test User",
      role: "STUDENT"
    });
    const token = regRes.data?.data?.accessToken || regRes.data?.data?.token;
    if (token) {
      bru.setVar("disposableUserToken", token);
    }
  } catch (err) {}
}

body:json {
  {
    "oldPassword": "InitialPassword@123",
    "newPassword": "UpdatedPassword@123",
    "confirmPassword": "UpdatedPassword@123"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}
