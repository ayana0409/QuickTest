meta {
  name: 1.15 SSO QuickBite - Credentials Flow
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/auth/sso/quickbite/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "username": "quickbite_test_user",
    "password": "Password@123"
  }
}

assert {
  // Accepts 200 if SSO server is online, or 401/500 if SSO service is unavailable locally
  res.status: in [200, 401, 500]
}
