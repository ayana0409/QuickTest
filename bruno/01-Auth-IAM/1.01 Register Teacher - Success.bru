meta {
  name: 1.01 Register Teacher - Success
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

script:pre-request {
  // Use timestamp to guarantee unique credentials on repeatable collection runs
  const rand = Date.now();
  bru.setVar("regTeacherUser", "teacher_" + rand);
  bru.setVar("regTeacherEmail", "teacher_" + rand + "@quicktest.com");
}

body:json {
  {
    "username": "{{regTeacherUser}}",
    "email": "{{regTeacherEmail}}",
    "password": "Teacher@123",
    "fullName": "Bruno Dynamic Teacher",
    "role": "TEACHER"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  let token = res.body?.data?.accessToken || res.body?.data?.token;
  if (token) {
    bru.setVar("teacherToken", token);
    bru.setEnvVar("teacherToken", token);
  }
}
