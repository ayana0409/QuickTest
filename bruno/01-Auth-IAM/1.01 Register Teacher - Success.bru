meta {
  name: 1.01 Register Teacher - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "username": "teacher_bruno",
    "email": "teacher_bruno@quicktest.com",
    "password": "Teacher@123",
    "fullName": "Bruno Teacher",
    "role": "TEACHER"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  let token = res.body?.data?.accessToken || res.body?.data?.token;
  if (token) {
    bru.setVar("teacherToken", token);
    bru.setEnvVar("teacherToken", token);
  }
}
