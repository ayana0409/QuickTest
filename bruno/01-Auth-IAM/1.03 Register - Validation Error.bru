meta {
  name: 1.03 Register - Validation Error
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "username": "ab",
    "email": "not-an-email",
    "password": "123",
    "fullName": "",
    "role": "STUDENT"
  }
}

assert {
  res.status: eq 400
}
