meta {
  name: 1.11 Refresh Token - Success
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
  res.body.data.accessToken: isDefined
  res.body.data.refreshToken: isDefined
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl') || 'http://localhost:8080';
  if (!bru.getEnvVar('refreshToken')) {
    try {
      const res = await axios.post(`${baseUrl}/api/auth/login`, {
        usernameOrEmail: 'teacher@quicktest.com',
        password: 'Teacher@123'
      });
      const rf = res.data?.data?.refreshToken;
      if (rf) {
        bru.setVar('refreshToken', rf);
        bru.setEnvVar('refreshToken', rf);
      }
    } catch (e) {}
  }
}

script:post-response {
  let token = res.body?.data?.accessToken;
  if (token) {
    bru.setVar("teacherToken", token);
    bru.setEnvVar("teacherToken", token);
  }
  let rf = res.body?.data?.refreshToken;
  if (rf) {
    bru.setVar("refreshToken", rf);
    bru.setEnvVar("refreshToken", rf);
  }
}
