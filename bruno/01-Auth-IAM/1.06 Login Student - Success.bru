meta {
  name: 1.06 Login Student - Success
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "usernameOrEmail": "student@quicktest.com",
    "password": "Student@123"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  let token = res.body?.data?.accessToken || res.body?.data?.token;
  if (token) {
    bru.setVar("studentToken", token);
    bru.setEnvVar("studentToken", token);
  }
  let refreshToken = res.body?.data?.refreshToken;
  if (refreshToken) {
    bru.setVar("studentRefreshToken", refreshToken);
    bru.setEnvVar("studentRefreshToken", refreshToken);
    bru.setVar("refreshToken", refreshToken);
    bru.setEnvVar("refreshToken", refreshToken);
  }
}
