meta {
  name: 1.16 SSO QuickBite - Auth Code Flow
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/auth/sso/quickbite/code
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "sample_oidc_authorization_code",
    "redirectUri": "http://localhost:3000/auth/callback"
  }
}

assert {
  // Accepts 200 if SSO server is online, or 401/500 if SSO service is unavailable locally
  res.status: in [200, 401, 500]
}
