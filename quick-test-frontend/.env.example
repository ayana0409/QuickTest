NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws-exam

# Chế độ bảo trì hệ thống (true/false)
MAINTAIN_MODE=false

# Khung giờ hoạt động hệ thống theo giờ Việt Nam (UTC+7, format 24h: HH:mm)
# Để trống nếu muốn hoạt động 24/7
STARTUP=07:00
SHUTDOWN=23:00