# ===================================================================
# Quick Test - Root .gitignore
# ===================================================================

# Compiled build outputs
target/
**/target/
build/
**/build/
!**/src/main/**/target/
!**/src/test/**/target/

# Packaging
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!**/mvnw
!**/mvnw.cmd
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log
/logs/
quick-test/logs/
!**/src/**/logs/

# STS / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code / Antigravity IDE
.vscode/
**/target-ide/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
quick-test/src/main/resources/application.properties

# ===================================================================
# Node & Frontend (Shared & Hoisted)
# ===================================================================
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

