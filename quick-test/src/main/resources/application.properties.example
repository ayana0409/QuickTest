# ===================================================================
# Quick Test Application - Configuration Template (Example)
# Copy this file to application.properties or customize the values below.
# ===================================================================

# -------------------------------------------------------------------
# Server Settings
# -------------------------------------------------------------------
server.port=8080
server.servlet.context-path=/api

# -------------------------------------------------------------------
# PostgreSQL Database Configuration
# -------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/quick_test_db
spring.datasource.username=postgres
spring.datasource.password=your_postgres_password
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool Settings
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.connection-timeout=20000

# -------------------------------------------------------------------
# JPA & Hibernate Configuration
# -------------------------------------------------------------------
# ddl-auto options: none, validate, update, create, create-drop
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false

# -------------------------------------------------------------------
# Redis Configuration (Exam session state, timer, question cache)
# -------------------------------------------------------------------
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.timeout=60000ms
# spring.data.redis.database=0

# -------------------------------------------------------------------
# RabbitMQ Configuration (High load messaging & async AI grading)
# -------------------------------------------------------------------
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest
# spring.rabbitmq.virtual-host=/

# -------------------------------------------------------------------
# JWT Security Configuration (IAM & Authentication)
# -------------------------------------------------------------------
# Secret key must be a base64 or secure 256-bit+ string for HMAC-SHA256
app.jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration time in milliseconds (e.g., 86400000 ms = 24 hours)
app.jwt.expiration-ms=86400000

# -------------------------------------------------------------------
# OAuth2 Resource Server / SSO (QuickBite / ABP Framework Identity Server)
# -------------------------------------------------------------------
# Uncomment when connecting to QuickBite OpenIddict / Identity Server
# spring.security.oauth2.resourceserver.jwt.issuer-uri=https://quickbite-auth.example.com
# spring.security.oauth2.resourceserver.jwt.jwk-set-uri=https://quickbite-auth.example.com/.well-known/openid-configuration/jwks

# -------------------------------------------------------------------
# Logging Configuration
# -------------------------------------------------------------------
logging.level.root=INFO
logging.level.com.quicktest=DEBUG
logging.level.org.springframework.security=INFO

# Cloudinary Configuration
cloudinary.cloud-name=xxx
cloudinary.api-key=xxx
cloudinary.api-secret=xxx
cloudinary.storage.upload-dir=uploads
cloudinary.storage.question-folder=quick-test/questions
cloudinary.storage.option-folder=quick-test/options
cloudinary.storage.image-base-url=https://res.cloudinary.com/xxx/image/upload/quick-test/questions/
cloudinary.upload.max-file-size-bytes=3145728
cloudinary.upload.allowed-formats=jpg,jpeg,png,webp,gif

# Multipart File Upload Configuration
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=100MB

# Google Gemini AI Configuration
gemini.api-key=xxx
gemini.model=gemini-3.5-flash-lite
gemini.base-url=https://generativelanguage.googleapis.com/v1beta/models
gemini.batch-size=5
gemini.max-tokens=4000
gemini.timeout-seconds=60

# Admin User Seed Configuration (auto-creates admin on startup if not present)
app.admin.seed.enabled=${APP_ADMIN_SEED_ENABLED:true}
app.admin.username=${APP_ADMIN_USERNAME:admin}
app.admin.email=${APP_ADMIN_EMAIL:admin@quicktest.com}
app.admin.password=${APP_ADMIN_PASSWORD:Admin@123}
app.admin.full-name=${APP_ADMIN_FULL_NAME:System Administrator}